---
import content from '../../data/hugofest.json';

const emprendimientos = content.logosBlock?.emprendimientos || [];

// Dividir en bloques de 8 emprendimientos por cada tarjeta/slide 1:1
const ITEMS_PER_PAGE = 8;
const pages = [];
for (let i = 0; i < emprendimientos.length; i += ITEMS_PER_PAGE) {
  pages.push(emprendimientos.slice(i, i + ITEMS_PER_PAGE));
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Render de Emprendimientos - Hugo Fest 2026</title>
  
  <!-- html2canvas para la descarga individual de cada slide 1:1 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap');

    :root {
      --color-acento: #FF8000;
      --color-acento2: #212121;
      --font-main: 'Montserrat', sans-serif;
      --font-mono: 'Space Mono', monospace;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: #121212;
      color: #ffffff;
      font-family: var(--font-main);
      padding: 40px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 50px;
    }

    .controls-bar {
      display: flex;
      gap: 15px;
      align-items: center;
      background: #1e1e1e;
      padding: 15px 30px;
      border-radius: 9999px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      position: sticky;
      top: 20px;
      z-index: 100;
      border: 1px solid rgba(255,128,0,0.3);
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn-action {
      background: linear-gradient(to right, #FF8000, #ffb100);
      color: #ffffff;
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      padding: 10px 20px;
      border-radius: 9999px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(255, 128, 0, 0.3);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-action:hover {
      transform: scale(1.05);
      box-shadow: 0 6px 20px rgba(255, 128, 0, 0.5);
    }

    /* Contenedor Cuadrado 1:1 exacto (diseñado para render nativo a 1080x1080px) */
    .slide-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
    }

    .slide-square {
      width: 100%;
      max-width: 650px;
      aspect-ratio: 1 / 1;
      background: linear-gradient(135deg, #FF8000 0%, #ff9e1b 50%, #ffb100 100%);
      border-radius: 24px;
      padding: 35px 40px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 20px 50px rgba(0,0,0,0.6);
      position: relative;
      overflow: hidden;
    }

    /* Encabezado del Slide */
    .slide-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid rgba(255,255,255,0.2);
      padding-bottom: 12px;
    }

    .slide-title {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 1.3rem;
      color: #ffffff;
      text-transform: uppercase;
      text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    }

    .slide-counter {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      background: rgba(0,0,0,0.25);
      padding: 4px 12px;
      border-radius: 9999px;
      color: #fff;
    }

    /* Grid de 8 filas compactas (2 columnas x 4 filas) */
    .emprendimientos-stack {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(4, 1fr);
      gap: 10px 15px;
      flex-grow: 1;
      padding: 12px 0;
    }

    .emprendimiento-row {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(0, 0, 0, 0.18);
      padding: 5px 10px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .emprendimiento-logo {
      width: 42px;
      height: 42px;
      border-radius: 8px;
      object-fit: cover;
      background: #ffffff;
      padding: 2px;
      flex-shrink: 0;
    }

    .emprendimiento-name {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 0.78rem;
      color: #ffffff;
      line-height: 1.12;
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.5), 0 2px 4px rgba(0,0,0,0.4);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-align: left;
    }

    /* Pie de página del slide */
    .slide-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 10px;
      border-top: 1px solid rgba(255,255,255,0.15);
    }

    .footer-brand {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: rgba(255,255,255,0.9);
      font-weight: 700;
      text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    }

    .next-page-icon {
      width: 32px;
      height: 32px;
      background: rgba(0, 0, 0, 0.25);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      animation: pulseArrow 2s infinite ease-in-out;
    }

    .next-page-icon svg {
      width: 18px;
      height: 18px;
    }

    @keyframes pulseArrow {
      0%, 100% { transform: translateX(0); }
      50% { transform: translateX(4px); }
    }

    /* Ocultar elementos en impresión general si se usa PDF */
    @media print {
      body { background: #fff; padding: 0; gap: 0; }
      .controls-bar { display: none; }
      .slide-wrapper { page-break-after: always; break-after: page; }
      .slide-square { box-shadow: none; max-width: 100%; width: 100vw; height: 100vh; border-radius: 0; }
    }
  </style>
</head>
<body>

  <div class="controls-bar">
    <span style="font-family: var(--font-mono); font-size: 0.9rem; font-weight: 700;">Generador 1:1 - Hugo Fest</span>
    <button class="btn-action" onclick="window.print()">Imprimir / Guardar Todas (PDF)</button>
  </div>

  {pages.map((pageItems, index) => {
    const isLastPage = index === pages.length - 1;
    const slideId = `slide-${index + 1}`;
    return (
      <div class="slide-wrapper">
        <div class="slide-square" id={slideId}>
          
          <div class="slide-header">
            <div class="slide-title">Emprendimientos Presentes</div>
            <div class="slide-counter">{index + 1} / {pages.length}</div>
          </div>

          <div class="emprendimientos-stack">
            {pageItems.map((item) => (
              <div class="emprendimiento-row">
                <img src={item.image} alt={item.name} class="emprendimiento-logo" crossorigin="anonymous" />
                <span class="emprendimiento-name">{item.name}</span>
              </div>
            ))}
          </div>

          <div class="slide-footer">
            <span class="footer-brand">Hugo Fest • Buen Fin 2026</span>
            {!isLastPage && (
              <div class="next-page-icon" title="Siguiente página">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            )}
          </div>

        </div>

        <button class="btn-action" onclick={`downloadSlide('${slideId}', ${index + 1})`}>
          Descargar Slide {index + 1} (PNG 1:1)
        </button>
      </div>
    );
  })}

  <script>
    // Función global para capturar y descargar cada slide en alta calidad 1080x1080px
    window.downloadSlide = function(elementId, pageNum) {
      const element = document.getElementById(elementId);
      if (!element) return;

      // Usamos html2canvas renderizando a escala 2 para asegurar definición impecable (1080x1080px reales)
      html2canvas(element, {
        scale: 2,
        useCORS: true,
        allowTaint: true,
        backgroundColor: null
      }).then(canvas => {
        const link = document.createElement('a');
        link.download = `HugoFest_Emprendedores_Slide_${pageNum}.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
      }).catch(err => {
        console.error("Error al generar la imagen:", err);
        alert("Hubo un detalle al generar la imagen. Intenta de nuevo.");
      });
    };
  </script>

</body>
</html>