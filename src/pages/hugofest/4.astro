---
import content from '../../data/hugofest.json';

const emprendimientos = content.logosBlock?.emprendimientos || [];

// Ordenar alfabéticamente si no lo estuvieran ya
const emprendimientosOrdenados = [...emprendimientos].sort((a, b) => 
  a.name.localeCompare(b.name)
);

// Dividir en bloques de 8 emprendimientos por cada tarjeta/slide 1:1
const ITEMS_PER_PAGE = 8;
const pages = [];
for (let i = 0; i < emprendimientosOrdenados.length; i += ITEMS_PER_PAGE) {
  pages.push(emprendimientosOrdenados.slice(i, i + ITEMS_PER_PAGE));
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Render - Slides Hugo Fest</title>
  
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Space+Mono:wght@700&display=swap');

    :root {
      --color-acento: #FF8000;
      --font-main: 'Montserrat', sans-serif;
      --font-mono: 'Space Mono', monospace;
    }

    body {
      background-color: #1a1a1a;
      color: #fff;
      font-family: var(--font-main);
      margin: 0;
      padding: 40px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 60px;
    }

    /* Controles Superiores */
    .controls {
      display: flex;
      gap: 20px;
      margin-bottom: 20px;
    }

    .btn-action {
      background: linear-gradient(to right, #FF8000, #ffb100);
      color: #ffffff;
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 1rem;
      text-transform: uppercase;
      padding: 15px 30px;
      border-radius: 9999px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(255, 128, 0, 0.4);
      transition: transform 0.2s;
    }
    
    .btn-action:hover {
      transform: scale(1.05);
    }

    /* Estructura del Wrapper para cada página */
    .page-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    /* Contenedor principal del Slide (1:1 Cuadrado sin redondeos) */
    .slide-container {
      width: 1080px;
      height: 1080px;
      background: linear-gradient(to top, var(--color-acento) 0%, #ffcc00 100%);
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 50px 60px;
      box-sizing: border-box;
      /* Sin border-radius para que sea picudo en redes sociales */
      overflow: hidden;
    }

    /* Estilo global para texto con glow blanco */
    .glow-text {
      color: #ffffff;
      font-family: var(--font-mono);
      text-transform: uppercase;
      text-shadow: 0 0 10px rgba(255,255,255,0.5), 0 0 30px rgba(255,255,255,0.4);
    }

    /* Cabecera del slide */
    .slide-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin-bottom: 30px;
      text-align: center;
    }

    .slide-title {
      font-size: 3rem;
      font-weight: 700;
      margin: 0;
    }

    .slide-counter {
      font-size: 1.5rem;
      font-weight: 700;
      margin-top: 5px;
    }

    /* Cuadrícula de 8 Emprendimientos */
    .emprendimientos-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(4, 1fr);
      gap: 30px;
      flex-grow: 1;
      height: 100%;
    }

    /* Fila individual de logo + texto (Sin fondos negros, 100% transparente) */
    .emprendimiento-row {
      display: flex;
      align-items: center;
      gap: 25px;
      height: 100%;
    }

    .emprendimiento-logo {
      height: 100%;
      max-height: 165px; /* Ajuste para aprovechar el 100% de la fila */
      aspect-ratio: 1/1;
      object-fit: cover;
      border-radius: 12px; /* Redondeo leve al logo, no al contenedor */
      box-shadow: 0 10px 20px rgba(0,0,0,0.15);
      background-color: #ffffff; /* Por si el logo es PNG transparente */
    }

    .emprendimiento-name {
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1.1;
    }

    /* Pie de página del slide */
    .slide-footer {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      margin-top: 30px;
      width: 100%;
    }

    .footer-brand {
      font-size: 1.8rem;
      font-weight: 700;
      text-align: center;
    }

    /* Icono SVG de siguiente (sin fondo negro) */
    .next-page-icon {
      position: absolute;
      right: 0;
      color: #ffffff;
      filter: drop-shadow(0 0 12px rgba(255,255,255,0.9));
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .next-page-icon svg {
      width: 70px;
      height: 70px;
      animation: bounceRight 2s infinite;
    }

    @keyframes bounceRight {
      0%, 100% { transform: translateX(0); }
      50% { transform: translateX(15px); }
    }

    /* Texto "Y MÁS..." en la última hoja */
    .y-mas-text {
      position: absolute;
      bottom: 50px;
      right: 60px;
      font-size: 3.5rem;
      font-weight: 800;
      line-height: 1;
    }

  </style>
  
  <!-- Script para descargar (html2canvas vía CDN) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" integrity="sha512-BNaRQnYJYiPSqHHDb58B0yaPfCu+Wgds8Gp/gZ33IqJwQxk/8/k0a5E/uH29D6+j2o6N/1rY+R/g3R2M6x5EFA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</head>
<body>

  <h1>Módulo de Renderizado - 1:1</h1>

  {pages.map((pageItems, index) => {
    const isLastPage = index === pages.length - 1;
    const slideId = `slide-${index + 1}`;
    
    return (
      <div class="page-wrapper">
        <div id={slideId} class="slide-container">
          
          <div class="slide-header">
            <h2 class="slide-title glow-text">Emprendimientos Presentes</h2>
            <div class="slide-counter glow-text">{index + 1} / {pages.length}</div>
          </div>

          <div class="emprendimientos-grid">
            {pageItems.map((item) => (
              <div class="emprendimiento-row">
                <img src={item.image} alt={item.name} class="emprendimiento-logo" />
                <span class="emprendimiento-name glow-text">{item.name}</span>
              </div>
            ))}
          </div>

          <div class="slide-footer">
            <span class="footer-brand glow-text">Hugo Fest • Buen Fin 2026</span>
            
            {!isLastPage && (
              <div class="next-page-icon" title="Siguiente página">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            )}
          </div>
          
          {/* El Y MÁS... va suelto dentro del slide-container para poder posicionarlo libremente sin romper el footer centrado */}
          {isLastPage && (
            <div class="y-mas-text glow-text">
              Y MÁS...
            </div>
          )}

        </div>

        <button class="btn-action download-btn" data-target={slideId} data-num={index + 1}>
          Descargar Slide {index + 1} (PNG 1080x1080)
        </button>
      </div>
    );
  })}

  <script is:inline>
    // Usamos event listeners nativos en vez de onclick inline para evitar bloqueos en Astro
    document.addEventListener("DOMContentLoaded", () => {
      const buttons = document.querySelectorAll(".download-btn");
      
      buttons.forEach(btn => {
        btn.addEventListener("click", () => {
          const targetId = btn.getAttribute("data-target");
          const slideNum = btn.getAttribute("data-num");
          const element = document.getElementById(targetId);
          
          // Efecto de carga en el botón
          const originalText = btn.innerText;
          btn.innerText = "Generando PNG...";
          btn.style.opacity = "0.7";
          btn.style.pointerEvents = "none";

          html2canvas(element, { 
            scale: 2, // Escala al doble para mejor resolución
            useCORS: true, 
            backgroundColor: null
            // Se eliminó allowTaint: true ya que bloquea el método toDataURL()
          }).then(canvas => {
            const link = document.createElement('a');
            link.download = `hugofest_slide_${slideNum}.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();
            
            // Restaurar botón
            btn.innerText = originalText;
            btn.style.opacity = "1";
            btn.style.pointerEvents = "auto";
          }).catch(err => {
            console.error("Error al generar imagen:", err);
            alert("Hubo un error al generar la imagen. Intenta recargar la página.");
            
            // Restaurar botón
            btn.innerText = originalText;
            btn.style.opacity = "1";
            btn.style.pointerEvents = "auto";
          });
        });
      });
    });
  </script>

</body>
</html>